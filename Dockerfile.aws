FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ENV VITE_DEMO_MODE=true
ENV VITE_API_URL=""
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt
COPY backend/ backend/
COPY src/ src/
COPY data/demo/ data/demo/
COPY --from=frontend /build/dist frontend/dist/
RUN useradd --uid 10001 --create-home f1 \
    && mkdir -p data/cache data/raw data/processed outputs /tmp/matplotlib \
    && chown -R f1:f1 /app /tmp/matplotlib
ENV PYTHONPATH=/app F1_DEMO_MODE=true MPLCONFIGDIR=/tmp/matplotlib PYTHONUNBUFFERED=1
USER f1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--limit-concurrency", "12"]
